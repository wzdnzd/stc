{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cpa-sub2api-converter",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
