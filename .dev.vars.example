# 本地开发必填。生产环境请在 Cloudflare 中配置为 Secret。
APP_PASSWORD="change-this-password"
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# 可选：只配置需要使用的目标；地址和密钥必须成对存在。
SUB2API_BASE_URL="https://sub2api.example.com"
SUB2API_ADMIN_API_KEY="replace-with-sub2api-admin-api-key"

CPA_BASE_URL="https://cpa.example.com"
CPA_MANAGEMENT_KEY="replace-with-cpa-management-key"

# 可选项
CPA_AUTH_MODE="auto"
SESSION_TTL_HOURS="168"
ALLOW_INSECURE_UPSTREAM="false"

# ---------- 上传上限（可选）----------
# 改完后需重新部署 / 重启 wrangler，前端通过 /api/config/status 的 limits 动态显示上限。

# 单批上传上限
# SUB2API 默认 100，绝对上限默认 5000（平台天花板 20000）
# MAX_SUB2API_ACCOUNTS="100"
# ABSOLUTE_MAX_SUB2API_ACCOUNTS="5000"
# CPA 默认 20，绝对上限默认 500（平台天花板 2000）
# MAX_CPA_FILES="20"
# ABSOLUTE_MAX_CPA_FILES="500"

# 前端并行上传批次数上限（页面可配，不得超过对应绝对上限）
# SUB2API 默认 3，绝对上限默认 50
# MAX_UPLOAD_CONCURRENCY_SUB2API="3"
# ABSOLUTE_MAX_UPLOAD_CONCURRENCY_SUB2API="50"
# CPA 默认 8，绝对上限默认 150
# MAX_UPLOAD_CONCURRENCY_CPA="8"
# ABSOLUTE_MAX_UPLOAD_CONCURRENCY_CPA="150"

# 上传重试次数上限（含首次；页面可配，默认 3）
# 绝对上限默认 10（平台天花板 30）
# MAX_SUB2API_UPLOAD_ATTEMPTS="3"
# MAX_CPA_UPLOAD_ATTEMPTS="3"
# ABSOLUTE_MAX_UPLOAD_ATTEMPTS="10"
